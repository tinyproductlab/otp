  --backup-item-border: #2E4264;
  --password-ledger-card: #101D30; --password-ledger-search: #111E31;
  --password-ledger-border: #22314A;
  --action-icon-tint: #8AB4F8; --action-icon-bg: #1D3048;
  --icon-edit-fg: #A8C7FA; --icon-edit-bg: #22324A;
  --icon-copy-fg: #8AB4F8; --icon-copy-bg: #1D3048;
  --icon-delete-fg: #F2B8B5; --icon-delete-bg: #4A2525;
  --dialog-input-bg: #0B1220; --dialog-input-stroke: #64748B; --dialog-ghost-bg: #334155;
}
