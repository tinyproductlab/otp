  --primary-reference-navy: #A8C7FA; --primary-reference-teal: #5EEAD4;
  --primary-reference-purple: #C4B5FD;
  --password-group-default-bg: #102A4A; --password-group-default-border: #155A91;
  --password-group-default-tint: #19A7FF; --password-group-custom-bg: #073B3D;
  --password-group-custom-border: #087D79; --password-group-custom-tint: #10D9CC;
  --settings-card-fill: #101B2B; --settings-status-fill: #162235;
  --settings-blue: #5590FF; --settings-blue-soft: #172A4A;
  --settings-green: #39D7A2; --settings-green-soft: #15382F;
  --settings-orange: #FFAA55; --settings-orange-soft: #3A2A1B;
  --settings-purple: #A875FF; --settings-purple-soft: #2A2043;
