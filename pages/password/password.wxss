
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--password-ledger-background);
}

.header {
  padding: 24rpx 32rpx 4rpx;
  flex-shrink: 0;
}

.header__top {
  display: flex;
  align-items: center;
}

.header__title {
  flex: 1;
  font-size: 38rpx;
  font-weight: bold;
  color: var(--primary-reference-title);
}

/* 安卓是独立排序按钮 + 弹窗,这里合成一个按钮直接切换,少一次点击 */
.header__sort {
  display: flex;
  align-items: center;
  padding: 8rpx 18rpx;
  background: var(--dialog-input-bg);
  border-radius: 24rpx;
}

.header__sort-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.header__sort-arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 2rpx solid var(--text-secondary);
  border-bottom: 2rpx solid var(--text-secondary);
  transform: rotate(45deg);
  margin-left: 10rpx;
  margin-top: -4rpx;
}

.search-wrap {
  padding: 16rpx 32rpx 12rpx;
  flex-shrink: 0;
}

.search__clear {
  width: 32rpx;
  height: 32rpx;
  position: relative;
  flex-shrink: 0;
}

.search__clear::before,
.search__clear::after {
  content: "";
  position: absolute;
  left: 4rpx;
  top: 15rpx;
  width: 24rpx;
  height: 3rpx;
  background: var(--text-hint);
}

.search__clear::before { transform: rotate(45deg); }
.search__clear::after { transform: rotate(-45deg); }

/* ---- 分组筛选 ---- */

.groups {
  white-space: nowrap;
  padding: 8rpx 32rpx 16rpx;
  flex-shrink: 0;
}

.group-chip {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  font-size: 25rpx;
  color: var(--text-secondary);
  background: var(--password-group-default-bg);
  border: 1rpx solid var(--password-group-default-border);
  border-radius: 26rpx;
}

.group-chip.is-active {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
  font-weight: 500;
}

.group-chip--add {
  background: var(--password-group-custom-bg);
  border-color: var(--password-group-custom-border);
  color: var(--password-group-custom-tint);
}

/* ---- 条目 ---- */

.list {
  flex: 1;
  min-height: 0;
  padding: 0 32rpx;
}

.entry {
  display: flex;
  align-items: center;
  min-height: 128rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: var(--password-ledger-card);
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(20, 42, 74, 0.05);
}

.entry__avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.entry__avatar-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.entry__main {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.entry__line {
  display: flex;
  align-items: center;
}

.entry__title {
  font-size: 31rpx;
  font-weight: 500;
  color: var(--text-main);
  max-width: 380rpx;
}

/* 风险标记:弱密码 / 重复密码。对齐安卓 ic_password_risk_* 的语义 */
.entry__risk {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.entry__risk--weak { background: var(--danger); }
.entry__risk--duplicate { background: var(--warning); }

.entry__account {
  display: block;
  font-size: 25rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.entry__copy {
  padding: 14rpx 24rpx;
  background: var(--icon-copy-bg);
  border-radius: 16rpx;
  flex-shrink: 0;
}

.entry__copy-text {
  font-size: 25rpx;
  color: var(--icon-copy-fg);
  font-weight: 500;
}

/* ---- 底部 ---- */

.footer {
  padding: 20rpx 32rpx;
  flex-shrink: 0;
  background: var(--password-ledger-background);
  border-top: 1rpx solid var(--card-stroke);
}


/* ============ 手势账本与搜索筛选 ============ */
.header__count {
  margin-left: 16rpx;
  font-size: 23rpx;
  color: var(--text-secondary);
}

.search-wrap {
  position: relative;
  z-index: 5;
}

.search {
  display: flex;
  align-items: center;
}

.search__filter {
  width: 68rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
  position: relative;
}

.search__filter.is-active {
  background: var(--settings-blue-soft);
  border-radius: 12rpx;
}

.search__filter-glyph {
  position: relative;
  width: 34rpx;
  height: 32rpx;
  box-sizing: border-box;
  border-top: 5rpx solid var(--text-secondary);
  border-left: 9rpx solid transparent;
  border-right: 9rpx solid transparent;
  border-bottom: 10rpx solid transparent;
}

.search__filter-glyph::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 18rpx;
  width: 6rpx;
  height: 10rpx;
  background: var(--text-secondary);
  border-radius: 2rpx;
}

.filter-menu {
  position: absolute;
  right: 32rpx;
  top: 86rpx;
  width: 220rpx;
  padding: 10rpx 0;
  border-radius: 24rpx;
  background: var(--card-background);
  box-shadow: 0 8rpx 28rpx rgba(20, 42, 74, 0.16);
}

.filter-menu__item {
  padding: 22rpx 28rpx;
  font-size: 27rpx;
  color: var(--text-secondary);
}

.filter-menu__item.is-active {
  color: var(--primary);
  font-weight: bold;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  min-height: 58vh;
  box-sizing: border-box;
  padding: 40rpx 40rpx 18vh;
  text-align: center;
}

.empty__detail {
  display: block;
  margin-top: 8rpx;
  white-space: normal;
}

.list-gesture-hint {
  display: block;
  padding: 18rpx 0 10rpx;
  text-align: center;
  font-size: 23rpx;
  color: var(--text-hint);
}

/* 与 TOTP 页一致：通过上下滑进入搜索和新增，不固定底部新增按钮 */
.add-menu-layer {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.24);
}

.add-menu-panel {
  width: 100%;
  padding: 30rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 32rpx 32rpx 0 0;
  background: var(--card-background);
  box-shadow: 0 -8rpx 30rpx rgba(20, 42, 74, 0.14);
}

.add-menu-panel__title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main);
}

.add-menu-option {
  display: flex;
  align-items: center;
  min-height: 82rpx;
  padding: 14rpx 4rpx;
  border-top: 1rpx solid var(--card-stroke);
}

.add-menu-option__icon {
  width: 62rpx;
  height: 62rpx;
  margin-right: 18rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #fff;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1;
}
.add-menu-option__icon--group { background: #3b82f6; }
.add-menu-option__icon--add { background: #22c55e; }
.add-menu-option__icon--import { background: #a855f7; }
.add-menu-option__icon--export { background: #3b82f6; }
.add-menu-option__icon--history { background: #f59e0b; }
.add-menu-option__copy { flex: 1; min-width: 0; }
.add-menu-option__title,
.add-menu-option__sub { display: block; }
.add-menu-option__title {
  font-size: 29rpx;
  color: var(--text-main);
  font-weight: 500;
}
.add-menu-option__sub {
  margin-top: 5rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}
.add-menu-option__arrow {
  margin-left: 12rpx;
  color: #94a3b8;
  font-size: 42rpx;
  font-weight: 300;
  line-height: 1;
}

/* 与首页 OTP 搜索框一致 */
.home-search {
  display: flex;
  align-items: center;
  height: 76rpx;
  margin: 14rpx 32rpx 22rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  background: var(--card-background);
  box-shadow: 0 3rpx 14rpx rgba(20, 42, 74, 0.08);
}

.home-search__icon {
  width: 22rpx;
  height: 22rpx;
  margin-right: 16rpx;
  border: 4rpx solid var(--text-hint);
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

.home-search__icon::after {
  content: "";
  position: absolute;
  right: -12rpx;
  bottom: -8rpx;
  width: 12rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--text-hint);
  transform: rotate(45deg);
}

.home-search__input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  font-size: 27rpx;
  color: var(--text-main);
}

.home-search__clear {
  width: 30rpx;
  height: 30rpx;
  margin-left: 8rpx;
  position: relative;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--border-soft);
}

.home-search__clear::before,
.home-search__clear::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 14rpx;
  width: 14rpx;
  height: 2rpx;
  background: var(--text-secondary);
  transform: rotate(45deg);
}

.home-search__clear::after { transform: rotate(-45deg); }

.home-search__filter {
  width: 68rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
}

.home-search__filter.is-active {
  background: var(--settings-blue-soft);
  border-radius: 12rpx;
}

.home-search__filter-glyph {
  width: 0;
  height: 0;
  position: relative;
  border-left: 17rpx solid transparent;
  border-right: 17rpx solid transparent;
  border-top: 24rpx solid #4A90D9;
}

.home-search__filter-glyph::after {
  content: "";
  position: absolute;
  left: -3rpx;
  top: -1rpx;
  width: 6rpx;
  height: 12rpx;
  border-radius: 2rpx;
  background: #4A90D9;
}

.home-filter-menu {
  position: absolute;
  right: 36rpx;
  margin-top: -12rpx;
  width: 220rpx;
  padding: 10rpx 0;
  border-radius: 24rpx;
  background: var(--card-background);
  box-shadow: 0 8rpx 28rpx rgba(20, 42, 74, 0.16);
  z-index: 8;
}

.home-filter-menu__item {
  display: block;
  padding: 22rpx 28rpx;
  font-size: 27rpx;
  color: var(--text-secondary);
}

.home-filter-menu__item.is-active {
  color: var(--primary);
  font-weight: bold;
}

.home-filter-menu__item + .home-filter-menu__item {
  border-top: 1rpx solid var(--card-stroke);
}

.home-search__filter-glyph,
.home-search__filter-glyph::after { pointer-events: none; }
.home-search__filter-glyph::after { box-sizing: border-box; }
.home-search__filter.is-active .home-search__filter-glyph { border-top-color: var(--primary); }
.home-search__filter.is-active .home-search__filter-glyph::after { background: var(--primary); }
.empty__detail { display: block; margin-top: 8rpx; white-space: normal; }

/* 安全行动计划深链带入的风险筛选提示 */
.risk-filter-note {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 28rpx 14rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid #f1dcb9;
  border-radius: 15rpx;
  background: #fff8eb;
}
.risk-filter-note__label { color: #9b691e; font-size: 22rpx; }
.risk-filter-note__clear { padding-left: 28rpx; color: #b47112; font-size: 21rpx; font-weight: 650; }


/* ============ 长按拖动排序 ============ */

/* 被抓起来的那条:抬高、半透明,让"它在手上"看得出来。
   不能加 transition —— translateY 是跟手逐帧改的,加过渡会拖泥带水。 */
.entry.is-dragging {
  position: relative;
  z-index: 10;
  opacity: 0.94;
  box-shadow: 0 12rpx 36rpx rgba(20, 42, 74, 0.22);
}

/* 手动排序模式下的操作提示 */
.sort-hint {
  margin: 0 32rpx 16rpx;
  padding: 14rpx 24rpx;
  border-radius: 16rpx;
  background: var(--primary-soft, rgba(47, 124, 246, 0.08));
  color: var(--primary);
  font-size: 24rpx;
  letter-spacing: 1rpx;
}
