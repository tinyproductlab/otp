<view class="page {{appThemeClass}}" bindtouchstart="onLedgerTouchStart" bindtouchend="onLedgerTouchEnd">

  <view class="header">
    <view class="header__top">
      <text class="header__title">静态密码账本</text>
      <text class="header__count">{{total}} 个账号</text>
    </view>
  </view>

  <view wx:if="{{searchActive}}" class="home-search">
      <view class="home-search__icon"></view>
      <input
        class="home-search__input"
        value="{{keyword}}"
        placeholder="搜索网站或账号"
        placeholder-class="text-hint"
        focus="{{searchActive}}"
        bindinput="onSearch"
        confirm-type="search" />
      <view wx:if="{{keyword}}" class="home-search__clear" bindtap="onClearSearch"></view>
      <view class="home-search__filter {{filterVisible ? 'is-active' : ''}}" bindtap="onToggleFilter" aria-label="筛选排序">
        <view class="home-search__filter-glyph"></view>
      </view>
  </view>
  <view wx:if="{{filterVisible}}" class="home-filter-menu" catchtap="noop">
    <view class="home-filter-menu__item {{sort === 'time' ? 'is-active' : ''}}" bindtap="onSelectSort" data-sort="time">按时间</view>
    <view class="home-filter-menu__item {{sort === 'name' ? 'is-active' : ''}}" bindtap="onSelectSort" data-sort="name">按名称</view>
    <view class="home-filter-menu__item {{sort === 'manual' ? 'is-active' : ''}}" bindtap="onSelectSort" data-sort="manual">手动排序</view>
  </view>

  <view wx:if="{{riskFilter}}" class="risk-filter-note">
    <text class="risk-filter-note__label">{{riskFilterLabel}}</text>
    <text class="risk-filter-note__clear" bindtap="onClearRiskFilter">清除</text>
  </view>

  <scroll-view wx:if="{{groups.length > 1}}" scroll-x class="groups" enable-flex>
    <view class="group-chip {{activeGroup === '' ? 'is-active' : ''}}" bindtap="onGroup" data-id="">
      全部 {{total}}
    </view>
    <view wx:for="{{groups}}" wx:key="id"
          class="group-chip {{activeGroup === item.id ? 'is-active' : ''}}"
          bindtap="onGroup" data-id="{{item.id}}"
          bindlongpress="onGroupLongPress" data-name="{{item.displayName}}" data-default="{{item.isDefault}}">
      {{item.displayName}} {{item.count}}
    </view>
    <view class="group-chip group-chip--add" bindtap="onCreateGroup">＋ 分组</view>
  </scroll-view>

  <view wx:if="{{sort === 'manual' && items.length > 1}}" class="sort-hint">长按条目拖动调整顺序</view>

  <scroll-view
    scroll-y
    class="list"
    wx:if="{{items.length}}"
    bindtouchstart="onLedgerTouchStart"
    bindtouchend="onLedgerTouchEnd">
    <view wx:for="{{items}}" wx:key="id"
          class="entry {{dragId === item.id ? 'is-dragging' : ''}}"
          style="{{dragId === item.id ? 'transform: translateY(' + dragOffset + 'px);' : ''}}"
          data-id="{{item.id}}"
          bindtap="onCopyPassword"
          bindlongpress="onLongPress"
          bindtouchmove="onDragMove"
          bindtouchend="onDragEnd"
          bindtouchcancel="onDragEnd">
      <view class="entry__avatar" style="background: {{item.avatarColor}}">
        <text class="entry__avatar-text">{{item.initial}}</text>
      </view>
      <view class="entry__main">
        <view class="entry__line">
          <text class="entry__title ellipsis">{{item.title || item.site || '未命名'}}</text>
          <view wx:if="{{item.risk}}" class="entry__risk entry__risk--{{item.risk}}"></view>
        </view>
        <text class="entry__account ellipsis">{{item.username || '—'}}</text>
      </view>
      <view class="entry__copy" catchtap="onCopyPassword" data-id="{{item.id}}">
        <text class="entry__copy-text">{{copiedId === item.id ? '已复制' : '复制'}}</text>
      </view>
    </view>
    <text class="list-gesture-hint">{{copy.gestureHint}}</text>
    <view style="height: 180rpx"></view>
  </scroll-view>

  <view
    wx:else
    class="empty"
    bindtouchstart="onLedgerTouchStart"
    bindtouchend="onLedgerTouchEnd">
    <text class="empty__title">{{keyword || activeGroup || riskFilter ? '没有匹配的记录' : '还没有保存密码'}}</text>
    <text class="empty__detail">{{keyword || activeGroup || riskFilter ? '换个条件试试' : copy.gestureHint}}</text>
    <text wx:if="{{keyword || activeGroup || riskFilter}}" class="empty__detail">{{copy.gestureHint}}</text>
  </view>

  <view wx:if="{{addMenuVisible}}" class="add-menu-layer" bindtap="onCloseAddMenu">
    <view class="add-menu-panel" catchtap="noop">
      <text class="add-menu-panel__title">静态密码账本</text>
      <view class="add-menu-option" bindtap="onCreateGroup">
        <text class="add-menu-option__icon add-menu-option__icon--group">▦</text>
        <view class="add-menu-option__copy"><text class="add-menu-option__title">新建分组</text><text class="add-menu-option__sub">创建一个新的密码分组</text></view>
        <text class="add-menu-option__arrow">›</text>
      </view>
      <view class="add-menu-option" bindtap="onAdd">
        <text class="add-menu-option__icon add-menu-option__icon--add">＋</text>
        <view class="add-menu-option__copy"><text class="add-menu-option__title">新建密码记录</text><text class="add-menu-option__sub">保存网站、账号、密码和备注</text></view>
        <text class="add-menu-option__arrow">›</text>
      </view>
      <view class="add-menu-option" bindtap="onImportPasswords">
        <text class="add-menu-option__icon add-menu-option__icon--import">↓</text>
        <view class="add-menu-option__copy"><text class="add-menu-option__title">导入</text><text class="add-menu-option__sub">导入 CSV 或 Bitwarden 静态密码账本</text></view>
        <text class="add-menu-option__arrow">›</text>
      </view>
      <view class="add-menu-option" bindtap="onExportPasswords">
        <text class="add-menu-option__icon add-menu-option__icon--export">↑</text>
        <view class="add-menu-option__copy"><text class="add-menu-option__title">导出</text><text class="add-menu-option__sub">导出加密静态密码账本</text></view>
        <text class="add-menu-option__arrow">›</text>
      </view>
      <view class="add-menu-option" bindtap="onGenerationRecords">
        <text class="add-menu-option__icon add-menu-option__icon--history">⚿</text>
        <view class="add-menu-option__copy"><text class="add-menu-option__title">密码生成记录</text><text class="add-menu-option__sub">查看已生成的密码记录</text></view>
        <text class="add-menu-option__arrow">›</text>
      </view>
    </view>
  </view>

</view>
