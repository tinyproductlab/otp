/* 图标软色底 */
.tint-blue { background: var(--settings-blue-soft); }
.tint-purple { background: var(--settings-purple-soft); }
.tint-green { background: var(--settings-green-soft); }
.tint-orange { background: var(--settings-orange-soft); }
.tint-teal { background: var(--settings-teal-soft); }
.tint-blue .glyph { background-color: var(--settings-blue); }
.tint-purple .glyph { background-color: var(--settings-purple); }
.tint-green .glyph { background-color: var(--settings-green); }
.tint-orange .glyph { background-color: var(--settings-orange); }
.tint-teal .glyph { background-color: var(--settings-teal); }

/* 细箭头 */
.chevron {
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid var(--text-hint);
  border-bottom: 3rpx solid var(--text-hint);
  transform: rotate(-45deg);
  opacity: 0.55;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* ============ 顶部品牌栏 ============ */

.topbar {
  display: flex;
  align-items: center;
  padding: 20rpx 36rpx 16rpx;
  flex-shrink: 0;
}

.topbar__logo {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
  background: #eef4ff;
  box-shadow: 0 4rpx 12rpx rgba(36, 92, 190, 0.16);
}

.topbar__copy {
  min-width: 0;
  margin-left: 22rpx;
}

.topbar__name {
  display: block;
  font-size: 52rpx;
  line-height: 1;
  font-weight: bold;
  letter-spacing: 2rpx;
  color: var(--primary-reference-title);
}

.topbar__sub {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--text-secondary);
}

.topbar__spacer {
  flex: 1;
}

.more-action {
  width: 56rpx;
  height: 76rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  flex-shrink: 0;
}

.more-action__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--primary-reference-title);
}

/* ============ ⋮ 菜单 ============ */

.more-menu-layer {
  position: fixed;
  z-index: 1100;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: transparent;
}

.more-menu-panel {
  position: absolute;
  top: 108rpx;
  right: 28rpx;
  width: 300rpx;
  padding: 10rpx 0;
  border-radius: 18rpx;
  background: var(--card-background);
  box-shadow: 0 8rpx 28rpx rgba(20, 42, 74, 0.16);
}

.more-menu-option {
  display: block;
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  color: var(--text-main);
  text-align: left;
  line-height: 1.4;
}

.more-menu-option:active {
  background: var(--settings-blue-soft);
}

.more-menu-option + .more-menu-option {
  border-top: 1rpx solid var(--card-stroke);
}

/* button 形态的菜单项（feedback / share）重置原生样式 */
.more-menu-option--plain {
  width: 100%;
  min-height: 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  font-weight: 400;
  white-space: nowrap;
}
.more-menu-option--plain::after { border: 0; }

/* ============ 滑动区 ============ */

.pager {
  flex: 1;
  min-height: 0;
}

.pane {
  height: 100%;
  /* 顶部留白原来由屏内的 page-head 撑出来；标题移到顶栏后由 pane 自己给 */
  padding: 24rpx 36rpx 40rpx;
}

.pane--otp {
  position: relative;
  padding-top: 18rpx;
}

/* ============ 入口卡（实用工具 / 数据管理通用） ============ */

.entry {
  display: flex;
  align-items: center;
  background: var(--card-background);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(20, 42, 74, 0.06);
}

.entry__icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.entry__icon .glyph {
  width: 40rpx;
  height: 40rpx;
}

.entry__main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.entry__title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--data-management-title);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry__sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ============ OTP 首页 · 搜索 ============ */

.home-search {
  display: flex;
  align-items: center;
  height: 76rpx;
  margin-bottom: 22rpx;
  padding: 0 22rpx;
  border-radius: 38rpx;
  background: var(--password-ledger-search);
}

.home-search__icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  background-color: var(--text-hint);
}

.home-search__input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  margin-left: 16rpx;
  font-size: 26rpx;
  color: var(--text-main);
}

.home-search__clear {
  width: 30rpx;
  height: 30rpx;
  position: relative;
  border-radius: 50%;
  background: var(--border-soft);
  flex-shrink: 0;
}

.home-search__clear::before,
.home-search__clear::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 14rpx;
  width: 14rpx;
  height: 2rpx;
  background: var(--text-secondary);
  transform: rotate(45deg);
}

.home-search__clear::after {
  transform: rotate(-45deg);
}

.home-search__filter {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
}

.home-search__filter.is-active {
  background: var(--settings-blue-soft);
}

.home-search__filter-glyph {
  width: 28rpx;
  height: 28rpx;
  background-color: var(--text-secondary);
}

.home-filter-menu {
  position: absolute;
  right: 36rpx;
  z-index: 8;
  margin-top: -12rpx;
  width: 220rpx;
  padding: 10rpx 0;
  border-radius: 24rpx;
  background: var(--card-background);
  box-shadow: 0 8rpx 28rpx rgba(20, 42, 74, 0.16);
}

.home-filter-menu__item {
  padding: 22rpx 28rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.home-filter-menu__item.is-active {
  color: var(--primary);
  font-weight: bold;
}

/* ============ OTP 首页 · 验证码卡片 ============ */

.home-token-list {
  padding-bottom: 20rpx;
}

.home-token {
  display: flex;
  align-items: center;
  min-height: 124rpx;
  box-sizing: border-box;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: var(--card-background);
  box-shadow: 0 4rpx 20rpx rgba(20, 42, 74, 0.06);
}

.home-token.is-expiring {
  box-shadow: 0 4rpx 24rpx rgba(217, 48, 37, 0.14);
}

/* 被抓起来的那张卡片:抬高、略微放大、半透明,让"它在手上"这件事看得出来。
   不能加 transition —— translateY 是跟手逐帧改的,加了过渡就会拖泥带水。 */
.home-token.is-dragging {
  position: relative;
  z-index: 10;
  opacity: 0.94;
  transform-origin: center;
  box-shadow: 0 12rpx 36rpx rgba(20, 42, 74, 0.22);
}

/* 手动排序模式下的操作提示 */
.sort-hint {
  margin: 0 4rpx 16rpx;
  padding: 14rpx 24rpx;
  border-radius: 16rpx;
  background: var(--primary-soft, rgba(47, 124, 246, 0.08));
  color: var(--primary);
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.home-token__identity {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  margin-right: 8rpx;
}

.home-token__brand {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  color: #fff;
}

.home-token__brand text {
  font-size: 26rpx;
  font-weight: bold;
}

.home-token__names {
  min-width: 0;
  flex: 1;
  margin-left: 20rpx;
}

.home-token__issuer,
.home-token__account {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-token__issuer {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
}

.home-token__account {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.home-token__code-area {
  width: 184rpx;
  flex-shrink: 0;
  text-align: center;
}

.home-token__code {
  display: block;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 38rpx;
  line-height: 1;
  letter-spacing: 3rpx;
  font-weight: bold;
  color: var(--primary);
}

.home-token.is-expiring .home-token__code {
  color: var(--danger);
}

.home-token__hint {
  display: block;
  margin-top: 6rpx;
  font-size: 18rpx;
  color: var(--text-hint);
}

.home-token__status {
  width: 84rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.home-token__remaining {
  width: 76rpx;
  padding: 6rpx 0;
  box-sizing: border-box;
  text-align: center;
  border-radius: 18rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--primary);
  background: var(--settings-blue-soft);
}

.home-token.is-expiring .home-token__remaining {
  color: var(--danger);
  background: var(--danger-surface);
}

.home-token__progress {
  width: 76rpx;
  height: 6rpx;
  margin-top: 10rpx;
  overflow: hidden;
  border-radius: 6rpx;
  background: var(--border-soft);
}

.home-token__progress-fill {
  height: 100%;
  border-radius: 6rpx;
  background: var(--primary);
}

.home-token.is-expiring .home-token__progress-fill {
  background: var(--danger);
}

.home-token-list__tail {
  height: 40rpx;
}

.home-gesture-hint {
  display: block;
  padding: 12rpx 0 28rpx;
  text-align: center;
  font-size: 23rpx;
  color: var(--text-hint);
}

/* ============ OTP 空态 ============ */

.otp-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 58vh;
  box-sizing: border-box;
  padding: 40rpx 40rpx 20vh;
  text-align: center;
}

.otp-empty__glyph {
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  background: var(--settings-blue-soft);
}

.otp-empty__clock {
  width: 60rpx;
  height: 60rpx;
  background-color: var(--primary);
}

.otp-empty__title {
  margin-top: 32rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-main);
}

.otp-empty__hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-hint);
}

/* ============ 添加验证码面板 ============ */

.add-menu-layer {
  position: fixed;
  z-index: 1000;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  padding: 0 3% calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.35);
}

.add-menu-panel {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 24rpx 16rpx;
  border-radius: 28rpx;
  background: var(--card-background);
}

.add-menu-handle {
  width: 56rpx;
  height: 6rpx;
  margin: 0 auto 16rpx;
  border-radius: 6rpx;
  background: var(--border-soft);
}

.add-menu-title {
  display: block;
  margin-bottom: 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-hint);
}

.add-menu-option {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 8rpx;
  border-radius: 20rpx;
}

.add-menu-option:active {
  background: var(--settings-blue-soft);
}

.add-menu-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 20rpx;
}

.add-menu-icon .glyph {
  width: 36rpx;
  height: 36rpx;
}

.add-menu-option__title {
  flex: 1;
  margin-left: 24rpx;
  font-size: 30rpx;
  color: var(--text-main);
}

/* ============ 底部三栏 ============ */

.tabbar {
  display: flex;
  flex-shrink: 0;
  border-top: 1rpx solid var(--card-stroke);
  background: var(--primary-page-background);
  padding-top: 16rpx;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 0;
}

.tab__icon {
  width: 44rpx;
  height: 44rpx;
  background-color: var(--text-hint);
}

.tab__label {
  font-size: 20rpx;
  color: var(--text-hint);
}

.tab.is-active .tab__icon {
  background-color: var(--primary);
}

.tab.is-active .tab__label {
  color: var(--primary);
  font-weight: 600;
}
