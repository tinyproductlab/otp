/**
 * 首页样式 —— 对齐「线框图-首页重设计-v1」
 *
 * 规则：
 *   1. 字号只用 6 档：52(品牌) / 40(页标题) / 30(卡标题) / 26/24(正文·副文案) / 20(角注)，
 *      验证码数字 38 是唯一的数字展示例外。
 *   2. 图标只有一套语言：线性 SVG 走 -webkit-mask 上色（背景色即图标色），
 *      深色模式由 colors.wxss 的变量自动翻转，此处零硬编码颜色。
 *   3. 不留旧版样式：本文件没有历史层叠，每个类只定义一次。
 */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--primary-page-background);
}

/* ============ 图标系统（mask 上色） ============ */

.glyph {
  display: block;
  background-color: var(--text-secondary);
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
}

