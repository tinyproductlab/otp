.page {
  height: 100vh;
  background: var(--settings-page-background);
}

.body {
  height: 100%;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.about-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 52rpx 0 34rpx;
}

.about-hero__logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 34rpx;
  box-shadow: 0 6rpx 18rpx rgba(36, 92, 190, 0.16);
}

.about-hero__title {
  margin-top: 22rpx;
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary-reference-title);
}

.about-hero__version {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.about-card {
  padding: 28rpx 30rpx;
}

.about-card__text,
.about-card__follow {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-main);
}

.about-card__text + .about-card__text {
  margin-top: 16rpx;
}

.about-card__version {
  display: block;
  margin-bottom: 14rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: var(--primary);
}

.about-card__follow {
  margin-top: 22rpx;
  color: var(--primary);
}

.about-card__copy {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  margin-top: 16rpx;
  padding: 0 22rpx;
  border: 2rpx solid var(--primary);
  border-radius: 30rpx;
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 600;
}

.about-card__copy:active { opacity: 0.68; }

.cloud-safety-note {
  margin: 20rpx 0;
  padding: 24rpx 26rpx;
  border: 2rpx solid var(--settings-blue);
  border-radius: 18rpx;
  background: var(--settings-blue-soft);
}
.cloud-safety-note__title,
.cloud-safety-note__text { display: block; }
.cloud-safety-note__title { color: var(--settings-blue); font-size: 27rpx; font-weight: 600; }
.cloud-safety-note__text { margin-top: 10rpx; color: var(--text-secondary); font-size: 23rpx; line-height: 1.65; }
