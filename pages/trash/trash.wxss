.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--settings-page-background);
}

.header {
  padding: 24rpx 32rpx 12rpx;
  flex-shrink: 0;
}

.header__title {
  display: block;
  font-size: 38rpx;
  font-weight: bold;
  color: var(--primary-reference-title);
}

.header__sub {
  display: block;
  font-size: 23rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.toolbar {
  display: flex;
  align-items: center;
  padding: 12rpx 32rpx 16rpx;
  flex-shrink: 0;
}

.toolbar__btn {
  font-size: 25rpx;
  color: var(--settings-blue);
  padding: 10rpx 16rpx;
}

.toolbar__btn--danger {
  color: var(--danger);
}

.toolbar__btn.is-disabled {
  opacity: 0.35;
}

.list {
  flex: 1;
  min-height: 0;
  padding: 0 32rpx;
}

.item {
  display: flex;
  align-items: center;
  padding: 26rpx 24rpx;
  margin-bottom: 14rpx;
  background: var(--settings-card-fill);
  border-radius: 20rpx;
}

.item__check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid var(--border-soft);
  flex-shrink: 0;
  margin-right: 22rpx;
  position: relative;
}

.item__check.is-checked {
  border-color: var(--primary);
  background: var(--primary);
}

.item__check.is-checked::after {
  content: "";
  position: absolute;
  left: 11rpx;
  top: 7rpx;
  width: 12rpx;
  height: 20rpx;
  border-right: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(40deg);
}

.item__main {
  flex: 1;
  min-width: 0;
}

.item__line {
  display: flex;
  align-items: center;
}

.item__badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.item__badge--password {
  background: var(--password-group-default-bg);
  color: var(--password-group-default-tint);
}

.item__badge--otp {
  background: var(--password-group-custom-bg);
  color: var(--password-group-custom-tint);
}

.item__title {
  font-size: 29rpx;
  color: var(--text-main);
  flex: 1;
}

.item__meta {
  display: block;
  font-size: 21rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
}

.footer {
  display: flex;
  padding: 20rpx 32rpx;
  gap: 20rpx;
  flex-shrink: 0;
  background: var(--settings-page-background);
  border-top: 1rpx solid var(--card-stroke);
}

.footer__btn {
  flex: 1;
}
