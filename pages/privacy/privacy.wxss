/* 全部走色板变量，不写死颜色 —— 原来卡片是 #FFF、文字是 #515C6C，
   深色模式下整页变成一大块白底配深灰字，等于没做深色。 */
.page { height:100vh; background:var(--primary-page-background); }
.body { height:100%; padding:0 28rpx; box-sizing:border-box; }
.section-title { display:block; margin:28rpx 12rpx 18rpx; font-size:30rpx; color:var(--text-secondary); }
.card--flat {
  background:var(--card-background);
  border-radius:24rpx;
  padding:28rpx;
  box-shadow:0 8rpx 24rpx var(--card-shadow, rgba(48,67,101,.06));
}
.privacy-card__text { display:block; margin-bottom:24rpx; color:var(--text-main); font-size:26rpx; line-height:1.75; }
.privacy-card__text:last-child { margin-bottom:0; }
