.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--settings-page-background);
}

.body {
  flex: 1;
  min-height: 0;
  padding: 0 28rpx;
}

/* ---- 密码行 ---- */

.pw-row {
  display: flex;
  align-items: center;
}

.pw-row__input {
  flex: 1;
  min-width: 0;
}

.pw-row__btn {
  padding: 0 8rpx;
  margin-left: 20rpx;
  font-size: 26rpx;
  color: var(--settings-blue);
  flex-shrink: 0;
}

/* ---- 强度条 ---- */

.meter {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.meter__track {
  flex: 1;
  height: 10rpx;
  border-radius: 5rpx;
  background: var(--border-soft);
  overflow: hidden;
}

.meter__fill {
  height: 100%;
  border-radius: 5rpx;
  transition: width 0.2s ease;
}

.meter__fill--weak { background: var(--danger); }
.meter__fill--fair { background: var(--warning); }
.meter__fill--good { background: var(--settings-blue); }
.meter__fill--strong { background: var(--success); }

.meter__label {
  font-size: 23rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.meter__label--weak { color: var(--danger); }
.meter__label--fair { color: var(--warning); }
.meter__label--good { color: var(--settings-blue); }
.meter__label--strong { color: var(--success); }

/* ---- 生成按钮行 ---- */

.gen-row {
  display: flex;
  padding: 20rpx 24rpx;
  gap: 20rpx;
}

.gen-row__btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 16rpx;
  background: var(--settings-purple-soft);
  color: var(--settings-purple);
  font-size: 27rpx;
  font-weight: 500;
}

/* ---- 分组选择 ---- */

.category-card { overflow: hidden; }
.group-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
}
.group-picker__label { flex: 1; min-width: 0; }
.group-picker__title {
  display: block;
  font-size: 29rpx;
  line-height: 1.35;
  color: var(--text-main);
  font-weight: 500;
}
.group-picker__hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.35;
  color: var(--text-hint);
}
.group-picker__selected {
  display: flex;
  align-items: center;
  max-width: 44%;
  margin-left: 24rpx;
  flex-shrink: 0;
}
.group-picker__value {
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 27rpx;
  color: var(--settings-blue);
  text-align: right;
}
.group-picker__arrow {
  width: 16rpx;
  height: 16rpx;
  margin-left: 16rpx;
  border-top: 3rpx solid var(--text-hint);
  border-right: 3rpx solid var(--text-hint);
  transform: rotate(45deg);
}
.notes-field { padding: 22rpx 24rpx 26rpx; }
.notes-field .field__textarea { min-height: 90rpx; }


/* ---- 元信息 ---- */

.meta {
  padding: 28rpx 32rpx 0;
}

.meta__text {
  display: block;
  font-size: 22rpx;
  color: var(--text-hint);
  line-height: 1.8;
}


.footer {
  padding: 20rpx 28rpx;
  flex-shrink: 0;
  background: var(--settings-page-background);
  border-top: 1rpx solid var(--card-stroke);
}
