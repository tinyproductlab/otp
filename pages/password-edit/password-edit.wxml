<view class="page {{appThemeClass}}">
  <scroll-view scroll-y class="body">

    <text class="section-title">基本信息</text>
    <view class="card--flat">
      <view class="field">
        <text class="field__label">标题</text>
        <input class="field__input" value="{{form.title}}" placeholder="如 GitHub"
               placeholder-class="text-hint" bindinput="onInput" data-key="title" />
      </view>
      <view class="row__divider"></view>
      <view class="field">
        <text class="field__label">网站</text>
        <input class="field__input" value="{{form.site}}" placeholder="如 github.com"
               placeholder-class="text-hint" bindinput="onInput" data-key="site" />
      </view>
      <view class="row__divider"></view>
      <view class="field">
        <text class="field__label">用户名 / 账号</text>
        <input class="field__input" value="{{form.username}}" placeholder="如 dev@example.com"
               placeholder-class="text-hint" bindinput="onInput" data-key="username" />
      </view>
    </view>

    <text class="section-title">密码</text>
    <view class="card--flat">
      <view class="field">
        <view class="pw-row">
          <input class="field__input pw-row__input {{revealed ? 'mono' : ''}}"
                 value="{{form.password}}"
                 password="{{!revealed}}"
                 placeholder="输入或生成密码"
                 placeholder-class="text-hint"
                 bindinput="onPasswordInput" />
          <view class="pw-row__btn" bindtap="onToggleReveal">{{revealed ? '隐藏' : '显示'}}</view>
        </view>

        <!-- 强度条 -->
        <view wx:if="{{form.password}}" class="meter">
          <view class="meter__track">
            <view class="meter__fill meter__fill--{{strength.level}}" style="width: {{strength.score}}%"></view>
          </view>
          <text class="meter__label meter__label--{{strength.level}}">{{strength.label}}</text>
        </view>
      </view>

      <view class="row__divider"></view>

      <view class="gen-row">
        <view class="gen-row__btn" bindtap="onOpenGenerator">打开密码生成器</view>
      </view>
    </view>

    <text class="section-title">归类</text>
    <view class="card--flat category-card">
      <picker class="group-picker" mode="selector" range="{{groupNames}}" value="{{groupIndex}}" bindchange="onGroupChange">
        <view class="group-picker__label">
          <text class="group-picker__title">所属分组</text>
          <text class="group-picker__hint">用于整理和筛选密码记录</text>
        </view>
        <view class="group-picker__selected">
          <text class="group-picker__value">{{groupNames[groupIndex]}}</text>
          <view class="group-picker__arrow"></view>
        </view>
      </picker>
      <view class="row__divider"></view>
      <view class="field notes-field">
        <text class="field__label">备注</text>
        <textarea class="field__textarea" value="{{form.notes}}" placeholder="选填"
                  placeholder-class="text-hint" bindinput="onInput" data-key="notes"
                  maxlength="1000" auto-height />
      </view>
    </view>

    <view wx:if="{{isEdit}}" class="meta">
      <text class="meta__text">创建于 {{createdAtText}}</text>
      <text class="meta__text">更新于 {{updatedAtText}}</text>
    </view>

    <view style="height: 200rpx"></view>
  </scroll-view>

  <view class="footer safe-bottom">
    <view class="btn btn--primary {{canSave ? '' : 'btn--disabled'}}" bindtap="onSave">保存</view>
  </view>
</view>
