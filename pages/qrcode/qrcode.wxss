.page {
  height: 100vh;
  background: var(--primary-page-background);
}

.content {
  height: 100%;
  box-sizing: border-box;
  padding: 28rpx 32rpx 40rpx;
}

.intro__title {
  display: block;
  font-size: 42rpx;
  font-weight: bold;
  color: var(--primary-reference-title);
}

.intro__sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

.input-card {
  margin-top: 26rpx;
  padding: 20rpx 24rpx 14rpx;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  background: var(--card-background);
  box-shadow: 0 3rpx 14rpx rgba(20, 42, 74, 0.07);
  transition: border-color 0.18s ease, box-shadow 0.18s ease;
}

.input-card--filled {
  border-color: var(--settings-blue-soft);
  box-shadow: 0 4rpx 18rpx rgba(74, 144, 217, 0.11);
}

.input {
  width: 100%;
  min-height: 84rpx;
  padding: 4rpx 0;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.55;
  color: var(--text-main);
}

.input-card__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 36rpx;
  margin-top: 14rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid var(--card-stroke);
}

.input-card__count {
  font-size: 21rpx;
  color: var(--text-hint);
}

.clear-btn {
  padding: 8rpx 12rpx;
  font-size: 22rpx;
  color: var(--danger);
}

.actions {
  display: flex;
  gap: 18rpx;
  margin-top: 22rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
}

.qr-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 22rpx;
  padding: 28rpx 24rpx 24rpx;
  border-radius: 28rpx;
  background: var(--card-background);
  box-shadow: 0 4rpx 18rpx rgba(20, 42, 74, 0.08);
}

.qr-canvas {
  display: block;
  width: 480rpx;
  height: 480rpx;
  background: #fff;
}

.qr-card__hint {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: var(--text-hint);
}

.qr-card__content {
  max-width: 600rpx;
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  font-size: 23rpx;
  line-height: 1.4;
  color: var(--text-secondary);
  background: var(--settings-bg);
  word-break: break-all;
}

.history {
  margin-top: 32rpx;
}

.section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: var(--primary-reference-title);
}

.section-title__sub {
  font-size: 22rpx;
  font-weight: normal;
  color: var(--text-hint);
}

.history-item {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  margin-bottom: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: var(--card-background);
}

.history-item__icon {
  width: 62rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 18rpx;
  font-size: 19rpx;
  font-weight: bold;
  color: var(--primary);
  background: var(--settings-blue-soft);
}

.history-item__main {
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
}

.history-item__content,
.history-item__meta {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-item__content {
  font-size: 26rpx;
  color: var(--text-main);
}

.history-item__meta {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: var(--text-hint);
}

.qr-placeholder {
  margin: 22rpx 0 28rpx;
  padding: 8rpx;
}

.qr-placeholder__box {
  height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--border-soft);
  border-radius: 28rpx;
  background: var(--card-background);
  color: var(--text-hint);
}

.qr-placeholder__mark {
  font-size: 64rpx;
  line-height: 1;
  color: var(--primary);
}

.qr-placeholder__text {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.qr-card__actions {
  display: flex;
  width: 100%;
  gap: 32rpx;
  margin-top: 24rpx;
}

.qr-card__actions .action-btn {
  width: 100%;
  min-width: 0;
  text-align: center;
}

/* 模拟器兼容：用固定黑白网格稳定显示二维码，canvas 仅用于下载 */
.qr-grid { width: 480rpx; height: 480rpx; padding: 32rpx; box-sizing: border-box; background: #fff; display: flex; flex-direction: column; }
.qr-grid__row { flex: 1; display: flex; min-height: 0; }
.qr-grid__cell { flex: 1; height: 100%; min-width: 0; background: #fff; }
.qr-grid__cell.is-dark { background: #111827; }
.qr-canvas { position: absolute; left: -9999px; top: -9999px; opacity: 0; }

