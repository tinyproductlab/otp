@import "styles/colors.wxss";

/* ============ 基础 ============ */

page {
  background: var(--primary-page-background);
  color: var(--text-main);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, input, textarea, scroll-view, swiper {
  box-sizing: border-box;
}

/* ============ 卡片 ============ */

.card {
  background: var(--card-background);
  border-radius: 24rpx;
  padding: 28rpx;
}

/* 安卓侧设置页的定稿:卡片无描边、无 tint 底色。这里保持一致。 */
.card--flat {
  background: var(--settings-card-fill);
  border-radius: 24rpx;
}

/* 区块标题在卡片**外**,卡片只框内容 —— 对齐安卓 fragment_appearance.xml 的定稿 */
.section-title {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 0 8rpx 12rpx;
  margin-top: 32rpx;
}

/* ============ 列表行 ============ */

.row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 0 24rpx;
}

.row__divider {
  height: 1rpx;
  background: var(--card-stroke);
  margin-left: 24rpx;
}

.row__main {
  flex: 1;
  min-width: 0;
}

.row__title {
  font-size: 30rpx;
  color: var(--text-main);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row__subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row__arrow {
  width: 32rpx;
  height: 32rpx;
  border-right: 3rpx solid var(--data-management-arrow);
  border-bottom: 3rpx solid var(--data-management-arrow);
  transform: rotate(-45deg);
  opacity: 0.5;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* ============ 搜索框 ============ */

.search {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 24rpx;
  background: var(--password-ledger-search);
  border-radius: 38rpx;
}

.search__icon {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid var(--text-hint);
  border-radius: 50%;
  position: relative;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.search__icon::after {
  content: "";
  position: absolute;
  right: -10rpx;
  bottom: -8rpx;
  width: 12rpx;
  height: 3rpx;
  background: var(--text-hint);
  transform: rotate(45deg);
}

.search__input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
}

/* ============ 按钮 ============ */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn--primary {
  background: var(--primary);
  color: #fff;
}

.btn--ghost {
  background: var(--dialog-ghost-bg);
  color: var(--text-main);
}

.btn--danger {
  background: var(--danger-surface);
  color: var(--danger);
}

.btn--text {
  color: var(--settings-blue);
  font-size: 28rpx;
  height: auto;
}

.btn[disabled], .btn--disabled {
  opacity: 0.45;
}

/* ============ 输入 ============ */

.field {
  padding: 20rpx 24rpx;
}

.field__label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}

.field__input {
  height: 72rpx;
  font-size: 30rpx;
  color: var(--text-main);
  background: var(--dialog-input-bg);
  border-radius: 12rpx;
  padding: 0 20rpx;
  width: 100%;
}

.field__textarea {
  min-height: 140rpx;
  font-size: 28rpx;
  color: var(--text-main);
  background: var(--dialog-input-bg);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  width: 100%;
}

/* ============ 空态 ============ */

.empty {
  padding: 140rpx 60rpx;
  text-align: center;
}

.empty__title {
  font-size: 30rpx;
  color: var(--text-secondary);
}

.empty__detail {
  font-size: 26rpx;
  color: var(--text-hint);
  margin-top: 12rpx;
  line-height: 1.6;
}

/* ============ 徽标 / 计数 ============ */

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 56rpx;
  height: 40rpx;
  padding: 0 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: bold;
}

/* ============ 通用工具类 ============ */

.flex { display: flex; align-items: center; }
.flex-1 { flex: 1; min-width: 0; }
.spacer { flex: 1; }
.mono { font-family: "SF Mono", Menlo, Consolas, monospace; }
.text-secondary { color: var(--text-secondary); }
.text-hint { color: var(--text-hint); }
.text-danger { color: var(--danger); }
.text-primary { color: var(--primary); }
.safe-bottom { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }


